# ============================================================
#  Antigravity :: B2B Cold Email Outreach System
#  Environment Variables  –  copy to .env and fill in values
# ============================================================

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Resend
RESEND_API_KEY=re_your_resend_api_key

# OpenAI (or DeepSeek-compatible endpoint)
OPENAI_API_KEY=sk-your-openai-api-key
# Optional: override base URL for DeepSeek or other compatible providers
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# Sender identity
SENDER_NAME=Your Name
SENDER_EMAIL=outreach@yourdomain.com
